rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla para la colección del proyecto 'Los Cuatro Evangelios'
    // Permite lectura y escritura para sincronizar datos locales con la nube
    match /proyectos/{projectId} {
      allow read, write: if true;
    }

    // Bloquea cualquier otra ruta o colección no especificada por seguridad
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
